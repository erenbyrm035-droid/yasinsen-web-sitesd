# ---------------------------------------------------------------------------
# VIVA SALES ENGINE — ortam degiskenleri
# Hicbiri zorunlu degil; hepsi bos birakilirsa sistem OSM discovery +
# kendi performans sezgiselleri + deterministik reasoning ile calisir.
# ---------------------------------------------------------------------------

# SQLite dosya yolu (varsayilan: ./data/viva.db)
VIVA_DB_PATH=./data/viva.db

# --- Lead Discovery kaynagi -------------------------------------------------
# 'osm' (varsayilan, ucretsiz, calisiyor) veya 'apollo'
LEAD_SOURCE=osm

# Apollo People Search REST API anahtari.
# NOT: Apollo Free plan bu ucu kapatiyor (API_INACCESSIBLE). Ayrintilar: docs/APOLLO.md
# Bos birakilirsa apollo adapter data/apollo-import.json dosyasini arar.
APOLLO_API_KEY=

# --- Website audit ----------------------------------------------------------
# Google PageSpeed Insights API anahtari (ucretsiz).
# Set edilirse gercek Lighthouse skorlari kullanilir; edilmezse yerel
# performans sezgiselleri (TTFB, HTML boyutu, render-blocking sayisi) devreye girer.
PAGESPEED_API_KEY=

# --- AI reasoning -----------------------------------------------------------
# Set edilirse ayni audit kanit seti Claude'a verilip dogal dil gerekce uretilir.
# Edilmezse gerekce audit kanitlarindan deterministik olarak kurulur.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
